<?xml version="1.0"?>
<robot name="f1tenth_minimal">
  <link name="base_link">
    <visual>
      <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.45 0.25 0.10"/>
      </geometry>
      <material name="body_blue">
        <color rgba="0.05 0.35 1.0 1.0"/>
      </material>
    </visual>
  </link>

  <link name="laser_frame">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.045" length="0.04"/>
      </geometry>
      <material name="laser_red">
        <color rgba="1.0 0.05 0.05 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="base_to_laser" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0.16 0.0 0.13" rpy="0.0 0.0 0.0"/>
  </joint>

  <link name="imu_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.06 0.04 0.02"/>
      </geometry>
      <material name="imu_orange">
        <color rgba="1.0 0.55 0.0 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.08" rpy="0.0 0.0 0.0"/>
  </joint>

</robot>
